PORT=3000
MAX_FILE_SIZE=5242880

# Option A – Mailgun (HTTP API; works on Render). Priority if all set.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=yourdomain.com
MAILGUN_FROM=notify@yourdomain.com

# Option B – Resend (HTTP API)
RESEND_API_KEY=re_xxxx
RESEND_FROM=onboarding@resend.dev

# Option C – SMTP (Gmail or any). Use SMTP_* for explicit host/port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
# Or: EMAIL_USERNAME, EMAIL_FROM, EMAIL_PASS (Gmail default)
